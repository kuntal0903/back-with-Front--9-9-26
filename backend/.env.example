# Environment Configuration Template
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# ─────────────────────────────────────────────
# API
# ─────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─────────────────────────────────────────────
# Database (PostgreSQL) — configured in later phases
# ─────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/attack_surface

# ─────────────────────────────────────────────
# Cache (Redis) — configured in later phases
# ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ─────────────────────────────────────────────
# Scanner Defaults — override per scanner in later phases
# ─────────────────────────────────────────────
DEFAULT_SCAN_TIMEOUT_SECONDS=10
DEFAULT_MAX_CONCURRENT_SCANS=5
